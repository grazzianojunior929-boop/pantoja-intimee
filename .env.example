# Copie para .env e preencha. Nunca publique o arquivo .env.

PORT=3000
NODE_ENV=development
# Endereço público do site (usado no retorno do pagamento). Ex.: https://pantojaintimee.com.br
BASE_URL=

# WhatsApp da loja: DDI 55 + DDD + número, só dígitos
WHATSAPP=5563992783793
INSTAGRAM=https://www.instagram.com/pantojaintimee01/

# Acesso ao painel /admin (criado na primeira execução; depois troque a senha pelo painel)
ADMIN_EMAIL=admin@pantojaintimee.com.br
ADMIN_SENHA=
# Texto longo e aleatório. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Frete em centavos (2000 = R$ 20,00). Frete grátis a partir de 19900 = R$ 199,00
FRETE_FIXO_CENTS=2000
FRETE_GRATIS_CENTS=19900

# Stripe (cartão). Deixe em branco para usar só o WhatsApp.
# Chaves em https://dashboard.stripe.com/apikeys (use sk_test_... para testar)
STRIPE_SECRET_KEY=
# Segredo do webhook (endpoint: <BASE_URL>/api/stripe/webhook, evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Pasta do banco de dados e das fotos (precisa ser um disco persistente em produção)
DATA_DIR=data
